uof:abstract-class-attribute-ccodes a uo:Finding ;
    dcterms:source ct:USDM_CT.xlsx,
        uml:dataStructure.yml,
        rdfrepo:usdm_v4.ttl ;
    dcterms:subject usdm:Identifier,
        usdm:PopulationDefinition,
        usdm:ScheduledInstance,
        usdm:StudyDesign,
        usdm:SyntaxTemplate ;
    dcterms:title "Abstract-class attributes carry a subclass's C-code" ;
    uo:checkFunction "abstract_class_attribute_ccodes" ;
    uo:evidenceTier uo:ModelStated ;
    uo:holds true ;
    uo:observation "27 of 388 C-coded attributes in dataStructure.yml differ from USDM_CT.xlsx. All differences are on abstract classes (Identifier 1, PopulationDefinition 9, ScheduledInstance 3, StudyDesign 9, SyntaxTemplate 5); 27 C-coded attributes are declared on abstract classes in total. usdm-rdf skos:exactMatch follows the YAML code for all 27." ;
    uo:standing uo:ReadyToRaise ;
    uo:standingRationale "Two published artefacts, dataStructure.yml and USDM_CT.xlsx, give different C-codes for the same attributes." ;
    uo:statement "For attributes declared on abstract classes, dataStructure.yml carries the C-code, preferred term and definition of one concrete subclass, not the abstract class's own entry in USDM_CT.xlsx. usdm-rdf renders the YAML, so its skos:exactMatch on these properties points to the subclass concept. Example: SyntaxTemplate.text carries C207478 Characteristic Text; USDM_CT.xlsx lists C207578 Syntax Template Text for SyntaxTemplate.text." ;
    uo:testedAgainst ct:USDM_CT.xlsx,
        uml:dataStructure.yml,
        <https://raw.githubusercontent.com/kerfors/usdm-rdf/v0.7.0/usdm_v4.ttl> .

uof:bc-property-datatype-names a uo:Finding ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    dcterms:subject usdm:BiomedicalConceptProperty ;
    dcterms:title "Biomedical concept property datatypes are uncontrolled names" ;
    uo:checkFunction "bc_property_datatype_names" ;
    uo:evidenceTier uo:ExampleObserved ;
    uo:holds true ;
    uo:observation "638 BiomedicalConceptProperty instances, 420 with empty datatype. Names used: text 93, float 69, integer 26, datetime 20, string 8, decimal 2. USDM_CT.xlsx Has Value List: N." ;
    uo:standing uo:ForDiscussion ;
    uo:standingRationale "Rests on the published example files, which are not mature study definitions." ;
    uo:statement "BiomedicalConceptProperty.datatype has no value list. The published examples use a small set of datatype names, including both 'text' and 'string', with nothing in the model to say whether they differ." ;
    uo:testedAgainst ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> .

uof:bc-reference-library-paths a uo:Finding ;
    dcterms:source <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    dcterms:subject usdm:BiomedicalConcept ;
    dcterms:title "Biomedical concept references are relative API paths" ;
    uo:checkFunction "bc_reference_library_paths" ;
    uo:evidenceTier uo:ExampleObserved ;
    uo:holds true ;
    uo:observation "116 BiomedicalConcept instances, 46 distinct references: 43 of the form /mdr/specializations/sdtm/packages/<date>/datasetspecializations/<name>, 3 of the form /mdr/bc/packages/<date>/biomedicalconcepts/<C-code>." ;
    uo:standing uo:ForDiscussion ;
    uo:standingRationale "Rests on the published example files, which are not mature study definitions." ;
    uo:statement "In the published examples, every BiomedicalConcept.reference is a relative CDISC Library API path, most into SDTM dataset specializations and some into biomedical concept packages. Resolving one needs a base URL and access to the Library." ;
    uo:testedAgainst <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> .

uof:code-system-free-strings a uo:Finding ;
    dcterms:source <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    dcterms:subject usdm:Code ;
    dcterms:title "Code systems are named by free strings" ;
    uo:checkFunction "code_system_free_strings" ;
    uo:evidenceTier uo:ExampleObserved ;
    uo:holds true ;
    uo:observation "2631 Code instances. codeSystem / codeSystemVersion pairs: 'http://www.cdisc.org' / '2024-09-27' 2534; 'ISO 3166 1 alpha3' / '2020-08' 42; 'SPONSOR' / '12' 25; 'SNOMED' / 'January 31, 2018' 20; 'ISO' / '1' 7; 'ICD-10-CM' / '1' 1; 'FDA' / '' 1; 'HL7' / '' 1." ;
    uo:standing uo:ForDiscussion ;
    uo:standingRationale "Identifying code systems by strings is a modelling choice; the examples show its effect." ;
    uo:statement "Code.codeSystem and Code.codeSystemVersion are free strings. In the published examples the code system is given in mixed forms, a URL for CDISC terminology and names for the others, and versions in several formats. A coded value is identified by strings, not by an IRI." ;
    uo:testedAgainst <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> .

uof:condition-not-referenced a uo:Finding ;
    dcterms:source rdfrepo:usdm_v4.ttl ;
    dcterms:subject usdm:Condition,
        usdm:ConditionAssignment,
        usdm:ScheduleTimeline ;
    dcterms:title "Schedule conditions are strings, not Condition instances" ;
    uo:evidenceTier uo:ModelStated ;
    uo:expectedResult true ;
    uo:holds true ;
    uo:observation "ASK returned true, expected true." ;
    uo:standing uo:ForDiscussion ;
    uo:standingRationale "Holding schedule conditions as strings may be a deliberate choice; the ask would be a modelling change." ;
    uo:statement "ConditionAssignment.condition and ScheduleTimeline.entryCondition have range xsd:string. The model has a Condition class, but neither attribute references it." ;
    uo:testQuery """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX usdm: <https://w3id.org/cdisc/usdm/v4/>
ASK {
    usdm:Condition a owl:Class .
    usdm:ConditionAssignment-condition rdfs:range xsd:string .
    usdm:ScheduleTimeline-entryCondition rdfs:range xsd:string .
}""" ;
    uo:testedAgainst <https://raw.githubusercontent.com/kerfors/usdm-rdf/v0.7.0/usdm_v4.ttl> .

uof:design-elements-not-linked-to-document a uo:Finding ;
    dcterms:source rdfrepo:usdm_v4.ttl ;
    dcterms:subject usdm:EligibilityCriterion,
        usdm:EligibilityCriterionItem,
        usdm:Endpoint,
        usdm:NarrativeContent,
        usdm:Objective ;
    dcterms:title "Objectives, endpoints and criteria have no link to document sections" ;
    uo:evidenceTier uo:ModelStated ;
    uo:expectedResult false ;
    uo:holds true ;
    uo:observation "ASK returned false, expected false." ;
    uo:standing uo:ForDiscussion ;
    uo:standingRationale "The model may leave the link between design elements and document sections out of scope on purpose." ;
    uo:statement "No property connects Objective, Endpoint, EligibilityCriterion or EligibilityCriterionItem to the document structure (StudyDefinitionDocument, StudyDefinitionDocumentVersion, NarrativeContent, NarrativeContentItem, DocumentContentReference), in either direction." ;
    uo:testQuery """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX usdm: <https://w3id.org/cdisc/usdm/v4/>
ASK {
    {
        VALUES ?d { usdm:Objective usdm:Endpoint usdm:SyntaxTemplate usdm:EligibilityCriterion usdm:EligibilityCriterionItem }
        VALUES ?r { usdm:StudyDefinitionDocument usdm:StudyDefinitionDocumentVersion usdm:NarrativeContent
                    usdm:NarrativeContentItem usdm:DocumentContentReference }
        ?p rdfs:domain ?d ; rdfs:range/(owl:unionOf/rdf:rest*/rdf:first)? ?r .
    } UNION {
        VALUES ?d { usdm:StudyDefinitionDocument usdm:StudyDefinitionDocumentVersion usdm:NarrativeContent
                    usdm:NarrativeContentItem usdm:DocumentContentReference }
        VALUES ?r { usdm:Objective usdm:Endpoint usdm:SyntaxTemplate usdm:EligibilityCriterion usdm:EligibilityCriterionItem }
        ?p rdfs:domain ?d ; rdfs:range/(owl:unionOf/rdf:rest*/rdf:first)? ?r .
    }
}""" ;
    uo:testedAgainst <https://raw.githubusercontent.com/kerfors/usdm-rdf/v0.7.0/usdm_v4.ttl> .

uof:document-content-reference-amendments-only a uo:Finding ;
    dcterms:source rdfrepo:usdm_v4.ttl ;
    dcterms:subject usdm:DocumentContentReference,
        usdm:StudyChange ;
    dcterms:title "Section references are used only for amendment changes" ;
    uo:evidenceTier uo:ModelStated ;
    uo:expectedResult false ;
    uo:holds true ;
    uo:observation "ASK returned false, expected false." ;
    uo:standing uo:ForDiscussion ;
    uo:standingRationale "Limiting section references to amendment changes may be deliberate." ;
    uo:statement "DocumentContentReference, the class that points at a document section by number and title, is the range of one property only: StudyChange.changedSections." ;
    uo:testQuery """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX usdm: <https://w3id.org/cdisc/usdm/v4/>
ASK {
    ?p rdfs:range/(owl:unionOf/rdf:rest*/rdf:first)? usdm:DocumentContentReference .
    FILTER (?p != usdm:StudyChange-changedSections)
}""" ;
    uo:testedAgainst <https://raw.githubusercontent.com/kerfors/usdm-rdf/v0.7.0/usdm_v4.ttl> .

uof:eligibility-identifier-needs-category a uo:Finding ;
    dcterms:source <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    dcterms:subject usdm:EligibilityCriterion ;
    dcterms:title "Eligibility identifier identifies only together with the category" ;
    uo:checkFunction "eligibility_identifier_needs_category" ;
    uo:evidenceTier uo:ExampleObserved ;
    uo:holds true ;
    uo:observation "Alexion_NCT04573309_Wilsons.json InterventionalStudyDesign_1: 31 criteria, 12 identifiers repeated, 0 repeated within a category; CDISC_Pilot_Study.json InterventionalStudyDesign_1: 31 criteria, 0 identifiers repeated, 0 repeated within a category; EliLilly_NCT03421379_Diabetes.json InterventionalStudyDesign_1: 36 criteria, 0 identifiers repeated, 0 repeated within a category; devices.json InterventionalStudyDesign_1: 4 criteria, 0 identifiers repeated, 0 repeated within a category; observational.json ObservationalStudyDesign_1: 5 criteria, 2 identifiers repeated, 0 repeated within a category." ;
    uo:standing uo:ForDiscussion ;
    uo:standingRationale "Rests on the published example files, which are not mature study definitions." ;
    uo:statement "In some published examples, EligibilityCriterion.identifier restarts per category (inclusion and exclusion each start at 1) and is not repeated within a category. The identifier alone does not identify a criterion; the identifier with the category does." ;
    uo:testedAgainst <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> .

uof:endpoint-activity-gap a uo:Finding ;
    dcterms:source rdfrepo:usdm_v4.ttl ;
    dcterms:subject usdm:Activity,
        usdm:BiomedicalConcept,
        usdm:Endpoint,
        usdm:Procedure ;
    dcterms:title "No link between Endpoint and what it requires" ;
    uo:evidenceTier uo:ModelStated ;
    uo:expectedResult false ;
    uo:holds true ;
    uo:observation "ASK returned false, expected false." ;
    uo:standing uo:ForDiscussion ;
    uo:standingRationale "The model may leave endpoint dependencies out of scope on purpose." ;
    uo:statement "No property connects Endpoint, or its superclass SyntaxTemplate, to Activity, Procedure, ScheduledActivityInstance or the biomedical concept classes, in either direction. The model does not carry which activities or biomedical concepts an endpoint depends on." ;
    uo:testQuery """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX usdm: <https://w3id.org/cdisc/usdm/v4/>
ASK {
    {
        VALUES ?d { usdm:Endpoint usdm:SyntaxTemplate }
        VALUES ?r { usdm:Activity usdm:Procedure usdm:ScheduledActivityInstance usdm:ScheduledInstance
                    usdm:BiomedicalConcept usdm:BiomedicalConceptCategory usdm:BiomedicalConceptSurrogate }
        ?p rdfs:domain ?d ; rdfs:range/(owl:unionOf/rdf:rest*/rdf:first)? ?r .
    } UNION {
        VALUES ?d { usdm:Activity usdm:Procedure usdm:ScheduledActivityInstance usdm:ScheduledInstance
                    usdm:BiomedicalConcept usdm:BiomedicalConceptCategory usdm:BiomedicalConceptSurrogate }
        VALUES ?r { usdm:Endpoint usdm:SyntaxTemplate }
        ?p rdfs:domain ?d ; rdfs:range/(owl:unionOf/rdf:rest*/rdf:first)? ?r .
    }
}""" ;
    uo:testedAgainst <https://raw.githubusercontent.com/kerfors/usdm-rdf/v0.7.0/usdm_v4.ttl> .

uof:extension-attributes-undefined a uo:Finding ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples>,
        rdfrepo:usdm_v4.ttl ;
    dcterms:subject usdm:ExtensionAttribute,
        usdm:ExtensionClass ;
    dcterms:title "Extension classes carry no definitions" ;
    uo:checkFunction "extension_attributes_undefined" ;
    uo:evidenceTier uo:ModelStated ;
    uo:holds true ;
    uo:observation "USDM_CT.xlsx rows for these classes: 0. usdm-rdf properties: 17, with skos:definition: 0. Instances in the published examples: 0." ;
    uo:standing uo:ReadyToRaise ;
    uo:standingRationale "Two classes in the published model have no definitions in any published artefact." ;
    uo:statement "ExtensionAttribute and ExtensionClass have no rows in USDM_CT.xlsx and no definitions in usdm-rdf. No published example uses them." ;
    uo:testedAgainst ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples>,
        <https://raw.githubusercontent.com/kerfors/usdm-rdf/v0.7.0/usdm_v4.ttl> .

uof:intercurrent-event-strategy-textual a uo:Finding ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://www.ema.europa.eu/documents/scientific-guideline/ich-e9-r1-addendum-estimands-sensitivity-analysis-clinical-trials-guideline-statistical-principles_en.pdf> ;
    dcterms:subject usdm:IntercurrentEvent ;
    dcterms:title "Intercurrent event strategy: fixed set, specified as text" ;
    uo:checkFunction "intercurrent_event_strategy_textual" ;
    uo:evidenceTier uo:Authored ;
    uo:holds true ;
    uo:observation "C188857 Intercurrent Event Strategy: A textual description of the planned strategy to manage and/or mitigate intercurrent events. Has Value List N." ;
    uo:rationale "The substance is one of a fixed set named by the guideline, possibly with explanation. Classifying by substance shows where a value list could carry meaning that the model holds as text." ;
    uo:standing uo:ForDiscussion ;
    uo:standingRationale "The gap to ICH E9(R1) is plain, but asking for a value list is a modelling request." ;
    uo:statement "IntercurrentEvent.strategy is defined as a textual description and has no value list. ICH E9(R1), section A.3.2, names five strategies: treatment policy, hypothetical, composite variable, while on treatment, principal stratum. The overlay classifies the attribute as classification as text; read by its definition alone it would be prose." ;
    uo:testedAgainst ct:USDM_CT.xlsx .

uof:narrative-content-text-by-reference a uo:Finding ;
    dcterms:source ct:USDM_CT.xlsx,
        rdfrepo:usdm_v4.ttl ;
    dcterms:subject usdm:NarrativeContent,
        usdm:NarrativeContentItem ;
    dcterms:title "NarrativeContent holds its text by reference" ;
    uo:evidenceTier uo:ModelStated ;
    uo:expectedResult true ;
    uo:holds true ;
    uo:observation "ASK returned true, expected true." ;
    uo:standing uo:ForDiscussion ;
    uo:standingRationale "Holding the text in a separate referenced item may be deliberate, for reuse across sections." ;
    uo:statement "NarrativeContent is defined as \"The container that holds an instance of unstructured text and which may include objects such as tables, figures, and images.\" The class has no text attribute. Its text is a NarrativeContentItem, which NarrativeContent references (contentItemId, relationship type Ref, 0..1) and which StudyVersion composes (narrativeContentItems). The section and its text are separate instances, linked by reference." ;
    uo:testQuery """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX usdm: <https://w3id.org/cdisc/usdm/v4/>
ASK {
    usdm:NarrativeContent skos:definition ?def .
    FILTER (STRSTARTS(STR(?def), "The container that holds an instance of unstructured text"))
    usdm:NarrativeContent-contentItemId rdfs:domain usdm:NarrativeContent ;
        rdfs:range usdm:NarrativeContentItem ; usdm:relationshipType "Ref" .
    usdm:StudyVersion-narrativeContentItems rdfs:range usdm:NarrativeContentItem ; usdm:relationshipType "Value" .
    FILTER NOT EXISTS {
        ?p rdfs:domain usdm:NarrativeContent ; rdfs:range usdm:NarrativeContentItem ; usdm:relationshipType "Value" .
    }
    FILTER NOT EXISTS {
        ?p rdfs:domain usdm:NarrativeContent ; rdfs:range xsd:string .
        FILTER (?p NOT IN (usdm:NarrativeContent-id, usdm:NarrativeContent-instanceType, usdm:NarrativeContent-name,
                           usdm:NarrativeContent-sectionNumber, usdm:NarrativeContent-sectionTitle))
    }
}""" ;
    uo:testedAgainst <https://raw.githubusercontent.com/kerfors/usdm-rdf/v0.7.0/usdm_v4.ttl> .

uof:narrative-references-by-markup a uo:Finding ;
    dcterms:source uml:dataStructure.yml,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    dcterms:subject usdm:NarrativeContentItem ;
    dcterms:title "Narrative refers to model instances by markup in text" ;
    uo:checkFunction "narrative_references_by_markup" ;
    uo:evidenceTier uo:ExampleObserved ;
    uo:holds true ;
    uo:observation "Alexion_NCT04573309_Wilsons.json: 467 usdm:ref in 105 narrative items, 17 classes; CDISC_Pilot_Study.json: 350 usdm:ref in 85 narrative items, 14 classes; EliLilly_NCT03421379_Diabetes.json: 234 usdm:ref in 112 narrative items, 16 classes; devices.json: 41 usdm:ref in 133 narrative items, 14 classes; observational.json: 26 usdm:ref in 6 narrative items, 11 classes. dataStructure.yml mentions usdm:ref: no." ;
    uo:standing uo:ForDiscussion ;
    uo:standingRationale "Rests on the published example files, which are not mature study definitions." ;
    uo:statement "In the published examples, NarrativeContentItem.text refers to model instances by usdm:ref elements inside the XHTML string, each naming a class (klass), an instance (id) and one attribute. The reference runs from the section to one attribute value. dataStructure.yml does not mention the convention." ;
    uo:testedAgainst uml:dataStructure.yml,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> .

uof:parameter-reference-by-markup a uo:Finding ;
    dcterms:source <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    dcterms:subject usdm:ParameterMap,
        usdm:SyntaxTemplate,
        usdm:SyntaxTemplateDictionary ;
    dcterms:title "Syntax-template parameters resolve through markup" ;
    uo:checkFunction "parameter_reference_by_markup" ;
    uo:evidenceTier uo:ExampleObserved ;
    uo:holds true ;
    uo:observation "usdm:ref markup in 14 of 15 ParameterMap.reference values. Other values: observational.json tag value_key = 1234.0." ;
    uo:standing uo:ForDiscussion ;
    uo:standingRationale "Rests on the published example files, which are not mature study definitions." ;
    uo:statement "In the published examples, ParameterMap.reference holds usdm:ref markup, the same convention as narrative text. A syntax-template parameter resolves to a model value through markup in a string, not through a model reference." ;
    uo:testedAgainst <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> .

uof:population-summary-term-vs-definition a uo:Finding ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://www.ema.europa.eu/documents/scientific-guideline/ich-e9-r1-addendum-estimands-sensitivity-analysis-clinical-trials-guideline-statistical-principles_en.pdf> ;
    dcterms:subject usdm:Estimand ;
    dcterms:title "Population-level summary: term and definition disagree" ;
    uo:checkFunction "population_summary_term_vs_definition" ;
    uo:evidenceTier uo:Authored ;
    uo:holds true ;
    uo:observation "C188853 Population-Level Summary: A synopsis of the clinical endpoint of interest within the analysis target study population. Has Value List N." ;
    uo:rationale "ICH E9(R1), section A.3.3, describes the attribute as a population-level summary for the variable, providing a basis for comparison between treatment conditions. Read that way the value is a statistical summary measure, close to a classification. Read by the NCI definition it is prose." ;
    uo:standing uo:ReadyToRaise ;
    uo:standingRationale "One USDM_CT.xlsx row carries two meanings: the preferred term is the ICH E9(R1) attribute, the definition a narrative synopsis." ;
    uo:statement "Estimand.populationSummary has the preferred term \"Population-Level Summary\", the ICH E9(R1) estimand attribute. Its definition, \"A synopsis of the clinical endpoint of interest within the analysis target study population\", describes a narrative synopsis. The attribute is left unclassified in the overlay until the two are reconciled." ;
    uo:testedAgainst ct:USDM_CT.xlsx .

uof:procedure-type-uncoded a uo:Finding ;
    dcterms:source ct:USDM_CT.xlsx ;
    dcterms:subject usdm:Endpoint,
        usdm:Procedure ;
    dcterms:title "Procedure type is an uncoded classification" ;
    uo:checkFunction "procedure_type_uncoded" ;
    uo:evidenceTier uo:DefinitionStated ;
    uo:holds true ;
    uo:observation "Procedure.procedureType (C188848): Has Value List N. Endpoint.level (C188826): Has Value List Y (C188726)." ;
    uo:standing uo:ReadyToRaise ;
    uo:standingRationale "USDM_CT.xlsx treats the same definition pattern as coded in one place and as a free string in another." ;
    uo:statement "Procedure.procedureType and Endpoint.level share the definition pattern \"A characterization or classification of ...\". Endpoint.level has a value list; Procedure.procedureType has none and is a string." ;
    uo:testedAgainst ct:USDM_CT.xlsx .

uof:study-amendment-number-not-numerals a uo:Finding ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    dcterms:subject usdm:StudyAmendment ;
    dcterms:title "Amendment number: definition says numerals, an example uses a letter" ;
    uo:checkFunction "study_amendment_number_not_numerals" ;
    uo:evidenceTier uo:ExampleObserved ;
    uo:holds true ;
    uo:observation "11 StudyAmendment.number values; not all digits: EliLilly_NCT03421379_Diabetes.json 'A'." ;
    uo:standing uo:ForDiscussion ;
    uo:standingRationale "Rests on the published example files, which are not mature study definitions." ;
    uo:statement "StudyAmendment.number is defined as \"A string of numerals that uniquely identifies a protocol amendment.\" A published example uses a letter." ;
    uo:testedAgainst ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> .

uof:syntax-template-parameters-rarely-used a uo:Finding ;
    dcterms:source <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    dcterms:subject usdm:SyntaxTemplate,
        usdm:SyntaxTemplateDictionary ;
    dcterms:title "Syntax-template parameters are rarely used" ;
    uo:checkFunction "syntax_template_parameters_rarely_used" ;
    uo:evidenceTier uo:ExampleObserved ;
    uo:holds true ;
    uo:observation "Syntax-template instances with a dictionary: 13 of 245. Per example: Alexion_NCT04573309_Wilsons.json: 1 of 87; CDISC_Pilot_Study.json: 4 of 51; EliLilly_NCT03421379_Diabetes.json: 0 of 73; devices.json: 3 of 17; observational.json: 5 of 17." ;
    uo:standing uo:ForDiscussion ;
    uo:standingRationale "Rests on the published example files, which are not mature study definitions." ;
    uo:statement "In the published examples, most syntax-template instances (Objective, Endpoint, EligibilityCriterionItem, IntercurrentEvent, Condition, Characteristic) have no dictionary, so their text carries no parameters the model can see." ;
    uo:testedAgainst <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> .

uof:template-tags-by-markup a uo:Finding ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    dcterms:subject usdm:ParameterMap,
        usdm:SyntaxTemplate,
        usdm:SyntaxTemplateDictionary ;
    dcterms:title "Template parameters are matched by name inside text" ;
    uo:checkFunction "template_tags_by_markup" ;
    uo:evidenceTier uo:ExampleObserved ;
    uo:holds true ;
    uo:observation "16 usdm:tag elements in 13 texts; stored tags containing angle brackets: 0. Unresolved: observational.json EligibilityCriterionItem_2 'max_agexxx'." ;
    uo:standing uo:ForDiscussion ;
    uo:standingRationale "Rests on the published example files, which are not mature study definitions." ;
    uo:statement "Syntax-template text marks parameters with usdm:tag elements that name a ParameterMap.tag. The stored tag is a bare name; the angle brackets that the NCI definition of ParameterMap.tag describes appear only in the template text. Resolution is by name inside a string, so a tag can lack a matching ParameterMap, and the published examples include such a case." ;
    uo:testedAgainst ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> .

uof:timing-iso8601-convention a uo:Finding ;
    dcterms:source ct:USDM_CT.xlsx,
        uml:dataStructure.yml,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    dcterms:subject usdm:Timing ;
    dcterms:title "Timing values follow ISO 8601 by convention only" ;
    uo:checkFunction "timing_iso8601_convention" ;
    uo:evidenceTier uo:ExampleObserved ;
    uo:holds true ;
    uo:observation "ISO 8601 durations among non-empty values: value 153 of 153; windowLower 30 of 30; windowUpper 30 of 30. '8601' in dataStructure.yml: no; in USDM_CT.xlsx definitions: no." ;
    uo:standing uo:ForDiscussion ;
    uo:standingRationale "Rests on the published example files, which are not mature study definitions." ;
    uo:statement "In the published examples, every non-empty Timing.value, windowLower and windowUpper is an ISO 8601 duration. Neither dataStructure.yml nor USDM_CT.xlsx names a syntax for them; the range is xsd:string." ;
    uo:testedAgainst ct:USDM_CT.xlsx,
        uml:dataStructure.yml,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> .

uof:timing-labels-restate-values a uo:Finding ;
    dcterms:source <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    dcterms:subject usdm:Timing ;
    dcterms:title "Timing labels are typed, not generated from the value" ;
    uo:checkFunction "timing_labels_restate_values" ;
    uo:evidenceTier uo:ExampleObserved ;
    uo:holds true ;
    uo:observation "76 distinct Timing.value values; 8 carry more than one valueLabel: P14D: '14 Days', '14 days'; P1D: '1 Day', '1 Days'; P2D: '2 Days', '2 days'; P2W: '2 Weeks', '2 weeks'; PT0M: '0 min', '0 mins', '0 minutes'; PT15M: '15 min', '15 mins'; PT30M: '30 min', '30 mins', '30 minutes'; PT5M: '5 min', '5 mins'." ;
    uo:standing uo:ForDiscussion ;
    uo:standingRationale "Rests on the published example files, which are not mature study definitions." ;
    uo:statement "Timing.valueLabel restates Timing.value in free text. In the published examples the same value carries differently spelled labels, so the label is not generated from the value." ;
    uo:testedAgainst <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> .

uo:isReferenced a owl:DatatypeProperty ;
    rdfs:label "is referenced" ;
    rdfs:domain uo:Assessment ;
    rdfs:range xsd:boolean ;
    skos:definition "Some attribute with relationship type Ref has the class or one of its superclasses in its range." .

uo:labelOf a owl:ObjectProperty ;
    rdfs:label "label of" ;
    rdfs:domain uo:Assessment ;
    skos:definition "For display labels: the attribute or attributes of the same class whose value the label renders." .

uo:observation a owl:DatatypeProperty ;
    rdfs:label "observation" ;
    rdfs:domain uo:Finding ;
    rdfs:range xsd:string ;
    skos:definition "What the test observed, including counts. Derived." .

uo:order a owl:DatatypeProperty ;
    rdfs:label "order" ;
    rdfs:domain uo:Rule ;
    rdfs:range xsd:integer .

uo:partCount a owl:DatatypeProperty ;
    rdfs:label "part count" ;
    rdfs:domain uo:Assessment ;
    rdfs:range xsd:integer ;
    skos:definition "Payload attributes of content kind Composition whose range is not a value type." .

uo:quote a owl:DatatypeProperty ;
    rdfs:label "quote" ;
    rdfs:domain uo:Assessment ;
    rdfs:range xsd:string ;
    skos:definition "Verbatim text from the source that the assessment rests on." .

uo:rationale a owl:DatatypeProperty ;
    rdfs:label "rationale" ;
    rdfs:range xsd:string ;
    skos:definition "Why an authored assessment assigns its kind, or why an authored finding is stated. Required on everything with evidence tier Authored." .

uo:readTextCount a owl:DatatypeProperty ;
    rdfs:label "read text count" ;
    rdfs:domain uo:Assessment ;
    rdfs:range xsd:integer ;
    skos:definition "Payload attributes whose content kind is a member of uo:ReadText." .

uo:referenceCount a owl:DatatypeProperty ;
    rdfs:label "reference count" ;
    rdfs:domain uo:Assessment ;
    rdfs:range xsd:integer ;
    skos:definition "Payload attributes of content kind Reference." .

uo:refines a owl:ObjectProperty ;
    rdfs:label "refines" ;
    rdfs:domain uo:Assessment ;
    rdfs:range uo:Assessment ;
    skos:definition "The derived assessment that an authored assessment refines. Where both exist, the authored kind is the one to use; the derived one is kept as the record of what the model and its definitions alone say." .

uo:standing a owl:ObjectProperty ;
    rdfs:label "standing" ;
    rdfs:domain uo:Finding ;
    rdfs:range skos:Concept ;
    skos:definition "Whether a finding is ready to raise with the publisher or is for discussion. Value from uo:FindingStandingScheme. Authored; needs uo:standingRationale." .

uo:standingRationale a owl:DatatypeProperty ;
    rdfs:label "standing rationale" ;
    rdfs:domain uo:Finding ;
    rdfs:range xsd:string ;
    skos:definition "Why the finding has its standing." .

uo:statement a owl:DatatypeProperty ;
    rdfs:label "statement" ;
    rdfs:domain uo:Finding ;
    rdfs:range xsd:string ;
    skos:definition "The finding in plain language. Qualitative; counts belong in the derived observation." .

uo:stringStructureCount a owl:DatatypeProperty ;
    rdfs:label "string structure count" ;
    rdfs:domain uo:Assessment ;
    rdfs:range xsd:integer ;
    skos:definition "Payload attributes whose content kind is a member of uo:StructureInString." .

uo:syntax a owl:DatatypeProperty ;
    rdfs:label "syntax" ;
    rdfs:domain uo:Assessment ;
    rdfs:range xsd:string ;
    skos:definition "For encoded values: the syntax the values follow." .

uo:testQuery a owl:DatatypeProperty ;
    rdfs:label "test query" ;
    rdfs:domain uo:Finding ;
    rdfs:range xsd:string ;
    skos:definition "A SPARQL ASK query run against usdm_v4.ttl." .

uo:testedAgainst a owl:ObjectProperty ;
    rdfs:label "tested against" ;
    rdfs:domain uo:Finding ;
    skos:definition "The pinned input the test was run against. Derived." .

uo:valueCount a owl:DatatypeProperty ;
    rdfs:label "value count" ;
    rdfs:domain uo:Assessment ;
    rdfs:range xsd:integer ;
    skos:definition "Payload attributes that are Coded or Typed value, or Composition of a value type." .

