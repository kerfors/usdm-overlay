# All usdm-overlay graphs merged: vocabulary, derived and authored. Generated by scripts/build_site.py.
@prefix ct: <https://github.com/cdisc-org/DDF-RA/blob/v4.0.0/Deliverables/CT/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfrepo: <https://github.com/kerfors/usdm-rdf/blob/v0.7.0/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix uml: <https://github.com/cdisc-org/DDF-RA/blob/v4.0.0/Deliverables/UML/> .
@prefix uo: <https://kerfors.github.io/usdm-overlay/> .
@prefix uoa: <https://kerfors.github.io/usdm-overlay/id/assessment/authored/classRole/> .
@prefix uoa1: <https://kerfors.github.io/usdm-overlay/id/assessment/authored/contentKind/> .
@prefix uod: <https://kerfors.github.io/usdm-overlay/id/assessment/classRole/> .
@prefix uod1: <https://kerfors.github.io/usdm-overlay/id/assessment/contentKind/> .
@prefix uof: <https://kerfors.github.io/usdm-overlay/id/finding/> .
@prefix usdm: <https://w3id.org/cdisc/usdm/v4/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

uo: a owl:Ontology ;
    dcterms:creator "Kerstin Forsberg" ;
    dcterms:description "Terms for an overlay graph that classifies and comments on the CDISC USDM v4 model as rendered in RDF/OWL by usdm-rdf. The overlay only points at usdm-rdf IRIs; it never changes them. Every assertion carries an evidence tier, so model-stated facts stay apart from readings of the model." ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "usdm-overlay vocabulary" ;
    rdfs:comment "Draft. Not a CDISC artifact." .

uo:MappingStated a skos:Concept ;
    skos:definition "Follows from what a published M11-to-USDM mapping file states in its rows (HL7 Clinical Study Protocol IG, CDISC DDF-RA), as read by m11-rdf D2: rows with a mapping record and rows left as residue alike." ;
    skos:inScheme uo:EvidenceTierScheme ;
    skos:prefLabel "Mapping-stated" ;
    skos:topConceptOf uo:EvidenceTierScheme .

uo:ReadText a skos:Collection ;
    skos:definition "Text kinds whose value is wording that states content for people to read: description, rationale, condition, classification, summary. Counts as text payload in the class-role roll-up." ;
    skos:member uo:ClassificationAsText,
        uo:CompanionText,
        uo:LogicAsText,
        uo:NarrativeText,
        uo:Prose,
        uo:StructuredText,
        uo:UnclassifiedString,
        uo:UnstructuredText ;
    skos:prefLabel "Read text" .

uo:StructureInString a skos:Collection ;
    skos:definition "Text kinds whose value names, identifies, cites, places or encodes something rather than stating content to be read. Does not count as text payload in the class-role roll-up." ;
    skos:member uo:BusinessIdentifier,
        uo:Citation,
        uo:CodeComponent,
        uo:ContactDetail,
        uo:DisplayLabel,
        uo:DocumentPosition,
        uo:EmbeddedReference,
        uo:EncodedValue,
        uo:LexicalVariant ;
    skos:prefLabel "Structure held in a string" .

uo:about a owl:ObjectProperty ;
    rdfs:label "about" ;
    rdfs:domain uo:Assessment ;
    skos:definition "The usdm-rdf term the assessment classifies." .

uo:assignedKind a owl:ObjectProperty ;
    rdfs:label "assigned kind" ;
    rdfs:domain uo:Assessment ;
    skos:definition "The concept the assessment assigns." .

uo:byRule a owl:ObjectProperty ;
    rdfs:label "by rule" ;
    rdfs:domain uo:Assessment ;
    rdfs:range uo:Rule ;
    skos:definition "The derivation rule that produced the assessment. Only on derived assessments." .

uo:checkFunction a owl:DatatypeProperty ;
    rdfs:label "check function" ;
    rdfs:domain uo:Finding ;
    rdfs:range xsd:string ;
    skos:definition "Name of the function in scripts/check_findings.py that tests the finding against the pinned inputs, for tests that SPARQL over usdm_v4.ttl cannot express." .

uo:classRole a owl:AnnotationProperty ;
    rdfs:label "class role" ;
    skos:definition "Links a usdm-rdf class to the role it plays in the model, judged by what the class itself holds. Shortcut for the assessment that carries the evidence." .

uo:companionOf a owl:ObjectProperty ;
    rdfs:label "companion of" ;
    rdfs:domain uo:Assessment ;
    skos:definition "For companion text: the sibling attribute, coded or typed, that the text qualifies." .

uo:composedInCount a owl:DatatypeProperty ;
    rdfs:label "composed in count" ;
    rdfs:domain uo:Assessment ;
    rdfs:range xsd:integer ;
    skos:definition "Number of distinct classes that declare an attribute with relationship type Value whose range includes the class or one of its superclasses." .

uo:contentKind a owl:AnnotationProperty ;
    rdfs:label "content kind" ;
    skos:definition "Links a usdm-rdf property to the kind of content it holds. Shortcut for the assessment that carries the evidence." .

uo:evidenceTier a owl:ObjectProperty ;
    rdfs:label "evidence tier" ;
    rdfs:domain uo:Assessment ;
    rdfs:range skos:Concept ;
    skos:definition "What kind of evidence the assessment rests on. Value from uo:EvidenceTierScheme." .

uo:expectedResult a owl:DatatypeProperty ;
    rdfs:label "expected result" ;
    rdfs:domain uo:Finding ;
    rdfs:range xsd:boolean ;
    skos:definition "The ASK result for which the finding holds." .

uo:hasNaming a owl:DatatypeProperty ;
    rdfs:label "has naming" ;
    rdfs:domain uo:Assessment ;
    rdfs:range xsd:boolean ;
    skos:definition "The class has at least one attribute of content kind Naming." .

uo:holds a owl:DatatypeProperty ;
    rdfs:label "holds" ;
    rdfs:domain uo:Finding ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the finding held when its test was last run. Derived." .

uoa:Duration a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:Duration ;
    uo:assignedKind uo:StructuredEntity ;
    uo:evidenceTier uo:Authored ;
    uo:quote "The length of time during which something continues." ;
    uo:rationale "The length of time is held in quantity. text restates the duration as unstructured text, and reasonDurationWillVary is companion text to the boolean durationWillVary. The derived rule ties two read text attributes against two values and assigns Text carrier; the substance is the quantity." ;
    uo:refines uod:Duration .

uoa:ScheduleTimelineExit a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:ScheduleTimelineExit ;
    uo:assignedKind uo:StructuredEntity ;
    uo:evidenceTier uo:Authored ;
    uo:quote "To go out of or leave the schedule timeline." ;
    uo:rationale "The class holds no payload. It is a node in the timeline structure, referenced from ScheduledActivityInstance.timelineExitId; its meaning is its position in that structure." ;
    uo:refines uod:ScheduleTimelineExit .

uoa:StudyDefinitionDocumentVersion a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:StudyDefinitionDocumentVersion ;
    uo:assignedKind uo:Aggregate ;
    uo:evidenceTier uo:Authored ;
    uo:quote "A representation of a particular edition or snapshot of the study definition document as it exists at a particular point in time." ;
    uo:rationale "The parts are the narrative content of the document edition (contents) and its governance dates (dateValues). The rest is the version string and a coded status. The derived rule needs parts to outnumber the other payload and finds a tie." ;
    uo:refines uod:StudyDefinitionDocumentVersion .

uoa:StudyElement a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:StudyElement ;
    uo:assignedKind uo:TextCarrier ;
    uo:evidenceTier uo:Authored ;
    uo:quote "A basic building block for time within a clinical study comprising the following characteristics: a description of what happens to the subject during the element; a definition of the start of the element; a rule for ending the element." ;
    uo:rationale "The model holds the three characteristics in the definition as the description (naming) and two TransitionRule parts, transitionStartRule and transitionEndRule, each a text carrier. The only other payload is a reference to study interventions. The derived rule counts the two TransitionRules as parts and assigns Aggregate; read through its parts, the content of the element is text." ;
    uo:refines uod:StudyElement .

uoa:Substance a uo:Assessment ;
    dcterms:source rdfrepo:usdm_v4.ttl ;
    uo:about usdm:Substance ;
    uo:assignedKind uo:StructuredEntity ;
    uo:evidenceTier uo:Authored ;
    uo:rationale "The two parts are the strengths of the substance and a reference substance, another Substance. They describe the substance itself; the class does not gather study content the way an aggregate does." ;
    uo:refines uod:Substance .

uoa1:Abbreviation-abbreviatedText a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:Abbreviation-abbreviatedText ;
    uo:assignedKind uo:LexicalVariant ;
    uo:evidenceTier uo:Authored ;
    uo:quote "The literal value of an instance of unstructured text that is used as the abbreviation." ;
    uo:rationale "The short form of the term whose long form the same instance holds in expandedText." ;
    uo:refines uod1:Abbreviation-abbreviatedText .

uoa1:Abbreviation-expandedText a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:Abbreviation-expandedText ;
    uo:assignedKind uo:LexicalVariant ;
    uo:evidenceTier uo:Authored ;
    uo:quote "The full literal representation of the abbreviation." ;
    uo:rationale "The long form of the abbreviated text held in the same instance." ;
    uo:refines uod1:Abbreviation-expandedText .

uoa1:Address-city a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:Address-city ;
    uo:assignedKind uo:ContactDetail ;
    uo:evidenceTier uo:Authored ;
    uo:quote "A relatively large and/or densely populated area of human habitation" ;
    uo:rationale "Part of a postal address." ;
    uo:refines uod1:Address-city .

uoa1:Address-district a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:Address-district ;
    uo:assignedKind uo:ContactDetail ;
    uo:evidenceTier uo:Authored ;
    uo:quote "An administrative or territorial division of a city, town, county, parish, state, country, or other locality" ;
    uo:rationale "Part of a postal address." ;
    uo:refines uod1:Address-district .

uoa1:Address-lines a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:Address-lines ;
    uo:assignedKind uo:ContactDetail ;
    uo:evidenceTier uo:Authored ;
    uo:quote "The street name and number, building number, apartment or unit number, or post office box number" ;
    uo:rationale "Part of a postal address." ;
    uo:refines uod1:Address-lines .

uoa1:Address-postalCode a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:Address-postalCode ;
    uo:assignedKind uo:ContactDetail ;
    uo:evidenceTier uo:Authored ;
    uo:quote "An alphanumeric code assigned to a mail delivery area." ;
    uo:rationale "Part of a postal address. A code in form, but assigned by postal services, not drawn from a value list." ;
    uo:refines uod1:Address-postalCode .

uoa1:Address-state a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:Address-state ;
    uo:assignedKind uo:ContactDetail ;
    uo:evidenceTier uo:Authored ;
    uo:quote "A sub-division of a country that forms part of a federal union." ;
    uo:rationale "Part of a postal address." ;
    uo:refines uod1:Address-state .

uoa1:Address-text a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    uo:about usdm:Address-text ;
    uo:assignedKind uo:DisplayLabel ;
    uo:evidenceTier uo:Authored ;
    uo:labelOf usdm:Address-city,
        usdm:Address-country,
        usdm:Address-district,
        usdm:Address-lines,
        usdm:Address-postalCode,
        usdm:Address-state ;
    uo:quote "A standardized representation of the complete set of components denoting the physical address" ;
    uo:rationale "The definition describes a representation of the address components the same instance holds; the published values are those components joined." ;
    uo:refines uod1:Address-text .

uoa1:AssignedPerson-jobTitle a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:AssignedPerson-jobTitle ;
    uo:assignedKind uo:ContactDetail ;
    uo:evidenceTier uo:Authored ;
    uo:quote "An identifying designation related to the assigned person's occupation." ;
    uo:rationale "Job title of the assigned person." ;
    uo:refines uod1:AssignedPerson-jobTitle .

uoa1:BiomedicalConcept-reference a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    uo:about usdm:BiomedicalConcept-reference ;
    uo:assignedKind uo:Citation ;
    uo:evidenceTier uo:Authored ;
    uo:quote "A citation to an authoritative source for a biomedical concept." ;
    uo:rationale "Cites the source of the concept. See finding bc-reference-library-paths." ;
    uo:refines uod1:BiomedicalConcept-reference .

uoa1:BiomedicalConcept-synonyms a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:BiomedicalConcept-synonyms ;
    uo:assignedKind uo:LexicalVariant ;
    uo:evidenceTier uo:Authored ;
    uo:quote "A word or an expression that serves as a figurative, symbolic, or exact substitute for a biomedical concept, and which has the same meaning." ;
    uo:rationale "Alternative wordings of the concept." ;
    uo:refines uod1:BiomedicalConcept-synonyms .

uoa1:BiomedicalConceptProperty-datatype a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    uo:about usdm:BiomedicalConceptProperty-datatype ;
    uo:assignedKind uo:ClassificationAsText ;
    uo:evidenceTier uo:Authored ;
    uo:quote "The structural format of the biomedical concept property response value." ;
    uo:rationale "The value names a datatype for the response value. The published examples use a small set of datatype names, and USDM_CT.xlsx gives no value list. See finding bc-property-datatype-names." ;
    uo:refines uod1:BiomedicalConceptProperty-datatype .

uoa1:BiomedicalConceptSurrogate-reference a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:BiomedicalConceptSurrogate-reference ;
    uo:assignedKind uo:Citation ;
    uo:evidenceTier uo:Authored ;
    uo:quote "A citation to an authoritative source for a biomedical concept surrogate." ;
    uo:rationale "Cites the source of the surrogate concept." ;
    uo:refines uod1:BiomedicalConceptSurrogate-reference .

uoa1:Code-code a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    uo:about usdm:Code-code ;
    uo:assignedKind uo:CodeComponent ;
    uo:evidenceTier uo:Authored ;
    uo:quote "The literal value of a code." ;
    uo:rationale "Identifies a concept only together with codeSystem and codeSystemVersion; the three strings stand in for one concept identifier. See finding code-system-free-strings." ;
    uo:refines uod1:Code-code .

uoa1:Code-codeSystem a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    uo:about usdm:Code-codeSystem ;
    uo:assignedKind uo:CodeComponent ;
    uo:evidenceTier uo:Authored ;
    uo:quote "The literal identifier (i.e., distinctive designation) of the system used to assign and/or manage codes." ;
    uo:rationale "Names the code system as a string. See finding code-system-free-strings." ;
    uo:refines uod1:Code-codeSystem .

uoa1:Code-codeSystemVersion a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    uo:about usdm:Code-codeSystemVersion ;
    uo:assignedKind uo:CodeComponent ;
    uo:evidenceTier uo:Authored ;
    uo:quote "The version of the code system." ;
    uo:rationale "Version of the code system as a string. See finding code-system-free-strings." ;
    uo:refines uod1:Code-codeSystemVersion .

uoa1:Code-decode a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:Code-decode ;
    uo:assignedKind uo:DisplayLabel ;
    uo:evidenceTier uo:Authored ;
    uo:labelOf usdm:Code-code ;
    uo:quote "Standardized or dictionary-derived human readable text associated with a code." ;
    uo:rationale "Human-readable text for the code held in the same instance." ;
    uo:refines uod1:Code-decode .

uoa1:ConditionAssignment-condition a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:ConditionAssignment-condition ;
    uo:assignedKind uo:LogicAsText ;
    uo:evidenceTier uo:Authored ;
    uo:quote "An assumption on which rests the validity or effect of something else." ;
    uo:rationale "The attribute holds the condition under which the decision instance moves to its target scheduled instance. The range is xsd:string and USDM_CT.xlsx gives no value list. The model has a Condition class, but this attribute does not reference it; the logic is held as text." ;
    uo:refines uod1:ConditionAssignment-condition .

uoa1:DocumentContentReference-sectionNumber a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:DocumentContentReference-sectionNumber ;
    uo:assignedKind uo:DocumentPosition ;
    uo:evidenceTier uo:Authored ;
    uo:quote "The numeric identifier of a particular section for the document content reference." ;
    uo:rationale "Points at a document section by its number. See finding document-content-reference-amendments-only." ;
    uo:refines uod1:DocumentContentReference-sectionNumber .

uoa1:DocumentContentReference-sectionTitle a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:DocumentContentReference-sectionTitle ;
    uo:assignedKind uo:DocumentPosition ;
    uo:evidenceTier uo:Authored ;
    uo:quote "An identifying designation for a particular section for the document content reference." ;
    uo:rationale "Points at a document section by its heading, alongside the section number." ;
    uo:refines uod1:DocumentContentReference-sectionTitle .

uoa1:Duration-reasonDurationWillVary a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:Duration-reasonDurationWillVary ;
    uo:assignedKind uo:CompanionText ;
    uo:companionOf usdm:Duration-durationWillVary ;
    uo:evidenceTier uo:Authored ;
    uo:quote "The explanation for why the event duration will vary within and/or across subjects." ;
    uo:rationale "Free text explaining the boolean sibling attribute durationWillVary." ;
    uo:refines uod1:Duration-reasonDurationWillVary .

uoa1:EligibilityCriterion-identifier a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    uo:about usdm:EligibilityCriterion-identifier ;
    uo:assignedKind uo:BusinessIdentifier ;
    uo:evidenceTier uo:Authored ;
    uo:quote "A sequence of characters used to identify, name, or characterize the inclusion or exclusion criterion." ;
    uo:rationale "Handle for a criterion within its study design, displayed in the protocol. In the published examples it restarts per category; see finding eligibility-identifier-needs-category." ;
    uo:refines uod1:EligibilityCriterion-identifier .

uoa1:Endpoint-purpose a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:Endpoint-purpose ;
    uo:assignedKind uo:Prose ;
    uo:evidenceTier uo:Authored ;
    uo:quote "The textual representation of the study endpoint purpose." ;
    uo:rationale "Free text describing why the endpoint is measured, for human readers. No value list." ;
    uo:refines uod1:Endpoint-purpose .

uoa1:ExtensionAttribute-url a uo:Assessment ;
    dcterms:source rdfrepo:usdm_v4.ttl ;
    uo:about usdm:ExtensionAttribute-url ;
    uo:assignedKind uo:ExtensionContent ;
    uo:evidenceTier uo:Authored ;
    uo:rationale "Identifies the extension definition. No definition in USDM_CT.xlsx or dataStructure.yml; see finding extension-attributes-undefined." ;
    uo:refines uod1:ExtensionAttribute-url .

uoa1:ExtensionAttribute-valueId a uo:Assessment ;
    dcterms:source rdfrepo:usdm_v4.ttl ;
    uo:about usdm:ExtensionAttribute-valueId ;
    uo:assignedKind uo:ExtensionContent ;
    uo:evidenceTier uo:Authored ;
    uo:rationale "Value of an extension attribute given as an instance id in a string. No definition in USDM_CT.xlsx or dataStructure.yml." ;
    uo:refines uod1:ExtensionAttribute-valueId .

uoa1:ExtensionAttribute-valueString a uo:Assessment ;
    dcterms:source rdfrepo:usdm_v4.ttl ;
    uo:about usdm:ExtensionAttribute-valueString ;
    uo:assignedKind uo:ExtensionContent ;
    uo:evidenceTier uo:Authored ;
    uo:rationale "Value of an extension attribute given as a string. No definition in USDM_CT.xlsx or dataStructure.yml." ;
    uo:refines uod1:ExtensionAttribute-valueString .

uoa1:ExtensionClass-url a uo:Assessment ;
    dcterms:source rdfrepo:usdm_v4.ttl ;
    uo:about usdm:ExtensionClass-url ;
    uo:assignedKind uo:ExtensionContent ;
    uo:evidenceTier uo:Authored ;
    uo:rationale "Identifies the extension class definition. No definition in USDM_CT.xlsx or dataStructure.yml." ;
    uo:refines uod1:ExtensionClass-url .

uoa1:Identifier-text a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    uo:about usdm:Identifier-text ;
    uo:assignedKind uo:BusinessIdentifier ;
    uo:evidenceTier uo:Authored ;
    uo:quote "An instance of structured text that represents the identifier." ;
    uo:rationale "The value is the identifier itself, issued within the organization that scopeId references. Inherited by all four Identifier subclasses. The derived assessment quotes the definition in usdm-rdf, which names the administrable product: dataStructure.yml carries a subclass's entry on this abstract-class attribute, see finding abstract-class-attribute-ccodes. The quote here is the abstract class's own entry in USDM_CT.xlsx." ;
    uo:refines uod1:Identifier-text .

uoa1:IntercurrentEvent-strategy a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://www.ema.europa.eu/documents/scientific-guideline/ich-e9-r1-addendum-estimands-sensitivity-analysis-clinical-trials-guideline-statistical-principles_en.pdf> ;
    uo:about usdm:IntercurrentEvent-strategy ;
    uo:assignedKind uo:ClassificationAsText ;
    uo:evidenceTier uo:Authored ;
    uo:quote "A textual description of the planned strategy to manage and/or mitigate intercurrent events." ;
    uo:rationale "ICH E9(R1) names a fixed set of strategies for intercurrent events, so the substance is a classification. The definition asks for a textual description and USDM_CT.xlsx gives no value list. Classified by substance; the conflict is recorded as finding intercurrent-event-strategy-textual." ;
    uo:refines uod1:IntercurrentEvent-strategy .

uoa1:MedicalDevice-hardwareVersion a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:MedicalDevice-hardwareVersion ;
    uo:assignedKind uo:BusinessIdentifier ;
    uo:evidenceTier uo:Authored ;
    uo:quote "A form or variant of hardware" ;
    uo:rationale "Version of the device hardware as assigned by its maker. Displayed and compared, not parsed." ;
    uo:refines uod1:MedicalDevice-hardwareVersion .

uoa1:MedicalDevice-softwareVersion a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:MedicalDevice-softwareVersion ;
    uo:assignedKind uo:BusinessIdentifier ;
    uo:evidenceTier uo:Authored ;
    uo:quote "A form or variant of software" ;
    uo:rationale "Version of the device software as assigned by its maker. Displayed and compared, not parsed." ;
    uo:refines uod1:MedicalDevice-softwareVersion .

uoa1:NarrativeContent-sectionNumber a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:NarrativeContent-sectionNumber ;
    uo:assignedKind uo:DocumentPosition ;
    uo:evidenceTier uo:Authored ;
    uo:quote "The numeric identifier assigned to a particular document section containing narrative content." ;
    uo:rationale "Position of the section in the document numbering. It changes when the document is restructured." ;
    uo:refines uod1:NarrativeContent-sectionNumber .

uoa1:NarrativeContent-sectionTitle a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:NarrativeContent-sectionTitle ;
    uo:assignedKind uo:DocumentPosition ;
    uo:evidenceTier uo:Authored ;
    uo:quote "An identifying designation for the document section containing narrative content." ;
    uo:rationale "Heading of the section as displayed in the document." ;
    uo:refines uod1:NarrativeContent-sectionTitle .

uoa1:Organization-identifier a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:Organization-identifier ;
    uo:assignedKind uo:BusinessIdentifier ;
    uo:evidenceTier uo:Authored ;
    uo:quote "A unique symbol that establishes identity of the organization." ;
    uo:rationale "Identifier issued by the organization named in identifierScheme. Displayed and compared, not parsed." ;
    uo:refines uod1:Organization-identifier .

uoa1:Organization-identifierScheme a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    uo:about usdm:Organization-identifierScheme ;
    uo:assignedKind uo:ClassificationAsText ;
    uo:evidenceTier uo:Authored ;
    uo:quote "The name of the organization that provides the identifier for the entity." ;
    uo:rationale "Names the organization that issues the identifier. The published examples use a small set of issuer names, and USDM_CT.xlsx gives no value list." ;
    uo:refines uod1:Organization-identifierScheme .

uoa1:ParameterMap-reference a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    uo:about usdm:ParameterMap-reference ;
    uo:assignedKind uo:EmbeddedReference ;
    uo:evidenceTier uo:Authored ;
    uo:quote "The reference for a tag used in programming languages, such as a markup language (e.g., HTML, XML), to store attributes and elements." ;
    uo:rationale "In the published examples the values are usdm:ref markup naming a class, an instance and an attribute, with a literal value as the exception. The pointer to the model lives inside a string, not in a model reference. See finding parameter-reference-by-markup." ;
    uo:refines uod1:ParameterMap-reference .

uoa1:ParameterMap-tag a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    uo:about usdm:ParameterMap-tag ;
    uo:assignedKind uo:BusinessIdentifier ;
    uo:evidenceTier uo:Authored ;
    uo:quote "Character strings bounded by angle brackets that act as containers for programming language elements." ;
    uo:rationale "Name of a parameter placeholder, matched by name against usdm:tag elements in syntax-template text. See finding template-tags-by-markup." ;
    uo:refines uod1:ParameterMap-tag .

uoa1:PersonName-familyName a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:PersonName-familyName ;
    uo:assignedKind uo:ContactDetail ;
    uo:evidenceTier uo:Authored ;
    uo:quote "A word or group of words indicating a person's last (family) name." ;
    uo:rationale "Part of a person name." ;
    uo:refines uod1:PersonName-familyName .

uoa1:PersonName-givenNames a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:PersonName-givenNames ;
    uo:assignedKind uo:ContactDetail ;
    uo:evidenceTier uo:Authored ;
    uo:quote "A word or group of words indicating a person's first (personal or given) name" ;
    uo:rationale "Part of a person name." ;
    uo:refines uod1:PersonName-givenNames .

uoa1:PersonName-prefixes a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:PersonName-prefixes ;
    uo:assignedKind uo:ContactDetail ;
    uo:evidenceTier uo:Authored ;
    uo:quote "An affix occurring at the start of the person name string" ;
    uo:rationale "Part of a person name." ;
    uo:refines uod1:PersonName-prefixes .

uoa1:PersonName-suffixes a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:PersonName-suffixes ;
    uo:assignedKind uo:ContactDetail ;
    uo:evidenceTier uo:Authored ;
    uo:quote "An affix occurring at the end of the person name" ;
    uo:rationale "Part of a person name." ;
    uo:refines uod1:PersonName-suffixes .

uoa1:PersonName-text a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:PersonName-text ;
    uo:assignedKind uo:DisplayLabel ;
    uo:evidenceTier uo:Authored ;
    uo:labelOf usdm:PersonName-familyName,
        usdm:PersonName-givenNames,
        usdm:PersonName-prefixes,
        usdm:PersonName-suffixes ;
    uo:quote "An instance of structured text that represents the person's full name." ;
    uo:rationale "The full name as one string, next to the name parts the same instance holds. Same reading as Address.text." ;
    uo:refines uod1:PersonName-text .

uoa1:Procedure-procedureType a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:Procedure-procedureType ;
    uo:assignedKind uo:ClassificationAsText ;
    uo:evidenceTier uo:Authored ;
    uo:quote "A characterization or classification of the study procedure." ;
    uo:rationale "The definition calls the value a classification, but USDM_CT.xlsx gives no value list and the range is xsd:string. The same definition pattern is coded elsewhere in the model, see finding procedure-type-uncoded." ;
    uo:refines uod1:Procedure-procedureType .

uoa1:ScheduleTimeline-entryCondition a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:ScheduleTimeline-entryCondition ;
    uo:assignedKind uo:LogicAsText ;
    uo:evidenceTier uo:Authored ;
    uo:quote "A logical evaluation on which rests the validity of entry into a schedule timeline." ;
    uo:rationale "The definition describes a logical evaluation. The range is xsd:string, USDM_CT.xlsx gives no value list, and the attribute does not reference the Condition class. The logic is held as text." ;
    uo:refines uod1:ScheduleTimeline-entryCondition .

uoa1:StudyAmendment-number a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    uo:about usdm:StudyAmendment-number ;
    uo:assignedKind uo:BusinessIdentifier ;
    uo:evidenceTier uo:Authored ;
    uo:quote "A string of numerals that uniquely identifies a protocol amendment." ;
    uo:rationale "Handle that orders amendments. Displayed and compared, not used in arithmetic. See finding study-amendment-number-not-numerals." ;
    uo:refines uod1:StudyAmendment-number .

uoa1:StudyAmendmentReason-otherReason a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:StudyAmendmentReason-otherReason ;
    uo:assignedKind uo:CompanionText ;
    uo:companionOf usdm:StudyAmendmentReason-code ;
    uo:evidenceTier uo:Authored ;
    uo:quote "The rationale for the change(s) to, or formal clarification of, a protocol that is not otherwise specified." ;
    uo:rationale "Free text for a reason that the coded sibling attribute code does not cover. Its meaning depends on that code." ;
    uo:refines uod1:StudyAmendmentReason-otherReason .

uoa1:StudyArm-dataOriginDescription a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:StudyArm-dataOriginDescription ;
    uo:assignedKind uo:CompanionText ;
    uo:companionOf usdm:StudyArm-dataOriginType ;
    uo:evidenceTier uo:Authored ;
    uo:quote "The textual representation of the study arm data origin." ;
    uo:rationale "Free text describing the data origin that the coded sibling attribute dataOriginType classifies." ;
    uo:refines uod1:StudyArm-dataOriginDescription .

uoa1:StudyChange-rationale a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:StudyChange-rationale ;
    uo:assignedKind uo:Prose ;
    uo:evidenceTier uo:Authored ;
    uo:quote "An explanation as to the logical reasons for why a study change has occurred." ;
    uo:rationale "Explanation of a change, written for human readers. No value list." ;
    uo:refines uod1:StudyChange-rationale .

uoa1:StudyDefinitionDocument-templateName a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    uo:about usdm:StudyDefinitionDocument-templateName ;
    uo:assignedKind uo:BusinessIdentifier ;
    uo:evidenceTier uo:Authored ;
    uo:quote "The literal identifier (i.e., distinctive designation) of the study definition document template." ;
    uo:rationale "The definition calls the value an identifier of the template, and that is followed here. The published values could also be read as a classification of templates." ;
    uo:refines uod1:StudyDefinitionDocument-templateName .

uoa1:StudyDefinitionDocumentVersion-version a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:StudyDefinitionDocumentVersion-version ;
    uo:assignedKind uo:BusinessIdentifier ;
    uo:evidenceTier uo:Authored ;
    uo:quote "A sequence of characters used to identify the version of the study definition document." ;
    uo:rationale "Handle for a document version. Displayed and compared, not parsed." ;
    uo:refines uod1:StudyDefinitionDocumentVersion-version .

uoa1:StudyDesign-rationale a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:StudyDesign-rationale ;
    uo:assignedKind uo:Prose ;
    uo:evidenceTier uo:Authored ;
    uo:quote "Reason(s) for choosing the study design." ;
    uo:rationale "Scientific reasoning for the design, written for human readers. No value list." ;
    uo:refines uod1:StudyDesign-rationale .

uoa1:StudyVersion-rationale a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:StudyVersion-rationale ;
    uo:assignedKind uo:Prose ;
    uo:evidenceTier uo:Authored ;
    uo:quote "A statement describing the overall rationale of the study." ;
    uo:rationale "Statement of the study's rationale, written for human readers. No value list." ;
    uo:refines uod1:StudyVersion-rationale .

uoa1:StudyVersion-versionIdentifier a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx ;
    uo:about usdm:StudyVersion-versionIdentifier ;
    uo:assignedKind uo:BusinessIdentifier ;
    uo:evidenceTier uo:Authored ;
    uo:quote "A sequence of characters used to identify, name, or characterize the study version." ;
    uo:rationale "Handle for a study version. Displayed and compared, not parsed." ;
    uo:refines uod1:StudyVersion-versionIdentifier .

uoa1:Timing-value a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    uo:about usdm:Timing-value ;
    uo:assignedKind uo:EncodedValue ;
    uo:evidenceTier uo:Authored ;
    uo:quote "The temporal value of the chronological relationship between temporal events." ;
    uo:rationale "Every value in the published examples parses as an ISO 8601 duration. The model files name no syntax and the range is xsd:string. See finding timing-iso8601-convention." ;
    uo:refines uod1:Timing-value ;
    uo:syntax "ISO 8601 duration" .

uoa1:Timing-valueLabel a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    uo:about usdm:Timing-valueLabel ;
    uo:assignedKind uo:DisplayLabel ;
    uo:evidenceTier uo:Authored ;
    uo:labelOf usdm:Timing-value ;
    uo:quote "The short descriptive designation for the timing value." ;
    uo:rationale "Free-text rendering of the encoded value. See finding timing-labels-restate-values." ;
    uo:refines uod1:Timing-valueLabel .

uoa1:Timing-windowLabel a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    uo:about usdm:Timing-windowLabel ;
    uo:assignedKind uo:DisplayLabel ;
    uo:evidenceTier uo:Authored ;
    uo:labelOf usdm:Timing-windowLower,
        usdm:Timing-windowUpper ;
    uo:quote "The short descriptive designation for a time period, or other type of interval, during which a temporal event may be achieved, obtained, or observed." ;
    uo:rationale "Free-text rendering of the window bounds, in a range notation of its own (lower..upper unit) that the model does not define." ;
    uo:refines uod1:Timing-windowLabel .

uoa1:Timing-windowLower a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    uo:about usdm:Timing-windowLower ;
    uo:assignedKind uo:EncodedValue ;
    uo:evidenceTier uo:Authored ;
    uo:quote "The earliest chronological value of an allowable period of time during which a temporal event takes place." ;
    uo:rationale "Every non-empty value in the published examples parses as an ISO 8601 duration. The model files name no syntax and the range is xsd:string. See finding timing-iso8601-convention." ;
    uo:refines uod1:Timing-windowLower ;
    uo:syntax "ISO 8601 duration" .

uoa1:Timing-windowUpper a uo:Assessment ;
    dcterms:source ct:USDM_CT.xlsx,
        <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> ;
    uo:about usdm:Timing-windowUpper ;
    uo:assignedKind uo:EncodedValue ;
    uo:evidenceTier uo:Authored ;
    uo:quote "The latest chronological value of an allowable period of time during which a temporal event takes place." ;
    uo:rationale "Every non-empty value in the published examples parses as an ISO 8601 duration. The model files name no syntax and the range is xsd:string. See finding timing-iso8601-convention." ;
    uo:refines uod1:Timing-windowUpper ;
    uo:syntax "ISO 8601 duration" .

