        uo:UnclassifiedString .

usdm:Code-codeSystemVersion uo:contentKind uo:CodeComponent,
        uo:UnclassifiedString .

usdm:Code-decode uo:contentKind uo:DisplayLabel,
        uo:UnclassifiedString .

