usdm:TransitionRule-name uo:contentKind uo:Naming .

usdm:TransitionRule-text uo:contentKind uo:UnstructuredText .

uo:UnassignedRole a skos:Concept ;
    skos:definition "The class has no payload, so the derivation assigns no role. Left to the authored layer." ;
    skos:inScheme uo:ClassRoleScheme ;
    skos:prefLabel "Unassigned role" ;
    skos:topConceptOf uo:ClassRoleScheme .

uo:rule-narrative-text a uo:Rule ;
    skos:definition "Range is xsd:string and the definition contains \"narrative representation\" (case-insensitive). The bare word \"narrative\" is not used: it also matches the class name NarrativeContent." ;
    uo:order 11 .

uo:rule-role-extension a uo:ClassRoleRule ;
    skos:definition "The class is in the range of an attribute of content kind ExtensionPoint, or every class that composes it was matched by this rule." ;
    uo:order 1 .

usdm:Abbreviation-abbreviatedText uo:contentKind uo:LexicalVariant,
        uo:UnstructuredText .

usdm:Abbreviation-expandedText uo:contentKind uo:LexicalVariant,
        uo:UnclassifiedString .

usdm:Activity uo:classRole uo:StructuredEntity .

