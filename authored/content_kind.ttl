@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix usdm: <https://w3id.org/cdisc/usdm/v4/> .
@prefix uo: <https://kerfors.github.io/usdm-overlay/> .
@prefix uoa: <https://kerfors.github.io/usdm-overlay/assessment/authored/contentKind/> .
@prefix uod: <https://kerfors.github.io/usdm-overlay/assessment/contentKind/> .
@prefix ct: <https://github.com/cdisc-org/DDF-RA/blob/v4.0.0/Deliverables/CT/> .

# Authored content-kind assessments. Hand-maintained.
# Each refines the derived assessment of the same attribute (derived/content_kind.ttl).
# Quotes are verbatim from USDM_CT.xlsx, sheet "DDF Entities&Attributes", column Definition;
# scripts/validate_authored.py checks them.

# ---------------------------------------------------------------- logic as text

uoa:ConditionAssignment-condition a uo:Assessment ;
    uo:about usdm:ConditionAssignment-condition ;
    uo:assignedKind uo:LogicAsText ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:ConditionAssignment-condition ;
    uo:quote "An assumption on which rests the validity or effect of something else." ;
    uo:rationale "The attribute holds the condition under which the decision instance moves to its target scheduled instance. The range is xsd:string and USDM_CT.xlsx gives no value list. The model has a Condition class, but this attribute does not reference it; the logic is held as text." ;
    dcterms:source ct:USDM_CT.xlsx .
usdm:ConditionAssignment-condition uo:contentKind uo:LogicAsText .

uoa:ScheduleTimeline-entryCondition a uo:Assessment ;
    uo:about usdm:ScheduleTimeline-entryCondition ;
    uo:assignedKind uo:LogicAsText ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:ScheduleTimeline-entryCondition ;
    uo:quote "A logical evaluation on which rests the validity of entry into a schedule timeline." ;
    uo:rationale "The definition describes a logical evaluation. The range is xsd:string, USDM_CT.xlsx gives no value list, and the attribute does not reference the Condition class. The logic is held as text." ;
    dcterms:source ct:USDM_CT.xlsx .
usdm:ScheduleTimeline-entryCondition uo:contentKind uo:LogicAsText .

# ---------------------------------------------------------------- classification as text

uoa:Procedure-procedureType a uo:Assessment ;
    uo:about usdm:Procedure-procedureType ;
    uo:assignedKind uo:ClassificationAsText ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:Procedure-procedureType ;
    uo:quote "A characterization or classification of the study procedure." ;
    uo:rationale "The definition calls the value a classification, but USDM_CT.xlsx gives no value list and the range is xsd:string. The same definition pattern is coded elsewhere in the model, see finding procedure-type-uncoded." ;
    dcterms:source ct:USDM_CT.xlsx .
usdm:Procedure-procedureType uo:contentKind uo:ClassificationAsText .

uoa:IntercurrentEvent-strategy a uo:Assessment ;
    uo:about usdm:IntercurrentEvent-strategy ;
    uo:assignedKind uo:ClassificationAsText ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:IntercurrentEvent-strategy ;
    uo:quote "A textual description of the planned strategy to manage and/or mitigate intercurrent events." ;
    uo:rationale "ICH E9(R1) names a fixed set of strategies for intercurrent events, so the substance is a classification. The definition asks for a textual description and USDM_CT.xlsx gives no value list. Classified by substance; the conflict is recorded as finding intercurrent-event-strategy-textual." ;
    dcterms:source ct:USDM_CT.xlsx ;
    dcterms:source <https://www.ema.europa.eu/documents/scientific-guideline/ich-e9-r1-addendum-estimands-sensitivity-analysis-clinical-trials-guideline-statistical-principles_en.pdf> .
usdm:IntercurrentEvent-strategy uo:contentKind uo:ClassificationAsText .

# ---------------------------------------------------------------- prose

uoa:Endpoint-purpose a uo:Assessment ;
    uo:about usdm:Endpoint-purpose ;
    uo:assignedKind uo:Prose ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:Endpoint-purpose ;
    uo:quote "The textual representation of the study endpoint purpose." ;
    uo:rationale "Free text describing why the endpoint is measured, for human readers. No value list." ;
    dcterms:source ct:USDM_CT.xlsx .
usdm:Endpoint-purpose uo:contentKind uo:Prose .

uoa:StudyDesign-rationale a uo:Assessment ;
    uo:about usdm:StudyDesign-rationale ;
    uo:assignedKind uo:Prose ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:StudyDesign-rationale ;
    uo:quote "Reason(s) for choosing the study design." ;
    uo:rationale "Scientific reasoning for the design, written for human readers. No value list." ;
    dcterms:source ct:USDM_CT.xlsx .
usdm:StudyDesign-rationale uo:contentKind uo:Prose .

uoa:StudyVersion-rationale a uo:Assessment ;
    uo:about usdm:StudyVersion-rationale ;
    uo:assignedKind uo:Prose ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:StudyVersion-rationale ;
    uo:quote "A statement describing the overall rationale of the study." ;
    uo:rationale "Statement of the study's rationale, written for human readers. No value list." ;
    dcterms:source ct:USDM_CT.xlsx .
usdm:StudyVersion-rationale uo:contentKind uo:Prose .

uoa:StudyChange-rationale a uo:Assessment ;
    uo:about usdm:StudyChange-rationale ;
    uo:assignedKind uo:Prose ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:StudyChange-rationale ;
    uo:quote "An explanation as to the logical reasons for why a study change has occurred." ;
    uo:rationale "Explanation of a change, written for human readers. No value list." ;
    dcterms:source ct:USDM_CT.xlsx .
usdm:StudyChange-rationale uo:contentKind uo:Prose .

# ---------------------------------------------------------------- companion text

uoa:StudyAmendmentReason-otherReason a uo:Assessment ;
    uo:about usdm:StudyAmendmentReason-otherReason ;
    uo:assignedKind uo:CompanionText ;
    uo:companionOf usdm:StudyAmendmentReason-code ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:StudyAmendmentReason-otherReason ;
    uo:quote "The rationale for the change(s) to, or formal clarification of, a protocol that is not otherwise specified." ;
    uo:rationale "Free text for a reason that the coded sibling attribute code does not cover. Its meaning depends on that code." ;
    dcterms:source ct:USDM_CT.xlsx .
usdm:StudyAmendmentReason-otherReason uo:contentKind uo:CompanionText .

uoa:StudyArm-dataOriginDescription a uo:Assessment ;
    uo:about usdm:StudyArm-dataOriginDescription ;
    uo:assignedKind uo:CompanionText ;
    uo:companionOf usdm:StudyArm-dataOriginType ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:StudyArm-dataOriginDescription ;
    uo:quote "The textual representation of the study arm data origin." ;
    uo:rationale "Free text describing the data origin that the coded sibling attribute dataOriginType classifies." ;
    dcterms:source ct:USDM_CT.xlsx .
usdm:StudyArm-dataOriginDescription uo:contentKind uo:CompanionText .

uoa:Duration-reasonDurationWillVary a uo:Assessment ;
    uo:about usdm:Duration-reasonDurationWillVary ;
    uo:assignedKind uo:CompanionText ;
    uo:companionOf usdm:Duration-durationWillVary ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:Duration-reasonDurationWillVary ;
    uo:quote "The explanation for why the event duration will vary within and/or across subjects." ;
    uo:rationale "Free text explaining the boolean sibling attribute durationWillVary." ;
    dcterms:source ct:USDM_CT.xlsx .
usdm:Duration-reasonDurationWillVary uo:contentKind uo:CompanionText .

# ---------------------------------------------------------------- encoded value

uoa:Timing-value a uo:Assessment ;
    uo:about usdm:Timing-value ;
    uo:assignedKind uo:EncodedValue ;
    uo:syntax "ISO 8601 duration" ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:Timing-value ;
    uo:quote "The temporal value of the chronological relationship between temporal events." ;
    uo:rationale "Every value in the published examples parses as an ISO 8601 duration. The model files name no syntax and the range is xsd:string. See finding timing-iso8601-convention." ;
    dcterms:source ct:USDM_CT.xlsx ;
    dcterms:source <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> .
usdm:Timing-value uo:contentKind uo:EncodedValue .

uoa:Timing-windowLower a uo:Assessment ;
    uo:about usdm:Timing-windowLower ;
    uo:assignedKind uo:EncodedValue ;
    uo:syntax "ISO 8601 duration" ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:Timing-windowLower ;
    uo:quote "The earliest chronological value of an allowable period of time during which a temporal event takes place." ;
    uo:rationale "Every non-empty value in the published examples parses as an ISO 8601 duration. The model files name no syntax and the range is xsd:string. See finding timing-iso8601-convention." ;
    dcterms:source ct:USDM_CT.xlsx ;
    dcterms:source <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> .
usdm:Timing-windowLower uo:contentKind uo:EncodedValue .

uoa:Timing-windowUpper a uo:Assessment ;
    uo:about usdm:Timing-windowUpper ;
    uo:assignedKind uo:EncodedValue ;
    uo:syntax "ISO 8601 duration" ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:Timing-windowUpper ;
    uo:quote "The latest chronological value of an allowable period of time during which a temporal event takes place." ;
    uo:rationale "Every non-empty value in the published examples parses as an ISO 8601 duration. The model files name no syntax and the range is xsd:string. See finding timing-iso8601-convention." ;
    dcterms:source ct:USDM_CT.xlsx ;
    dcterms:source <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> .
usdm:Timing-windowUpper uo:contentKind uo:EncodedValue .

# ---------------------------------------------------------------- embedded reference

uoa:ParameterMap-reference a uo:Assessment ;
    uo:about usdm:ParameterMap-reference ;
    uo:assignedKind uo:EmbeddedReference ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:ParameterMap-reference ;
    uo:quote "The reference for a tag used in programming languages, such as a markup language (e.g., HTML, XML), to store attributes and elements." ;
    uo:rationale "In the published examples the values are usdm:ref markup naming a class, an instance and an attribute, with a literal value as the exception. The pointer to the model lives inside a string, not in a model reference. See finding parameter-reference-by-markup." ;
    dcterms:source ct:USDM_CT.xlsx ;
    dcterms:source <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> .
usdm:ParameterMap-reference uo:contentKind uo:EmbeddedReference .

# ---------------------------------------------------------------- classification as text (from examples)

uoa:BiomedicalConceptProperty-datatype a uo:Assessment ;
    uo:about usdm:BiomedicalConceptProperty-datatype ;
    uo:assignedKind uo:ClassificationAsText ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:BiomedicalConceptProperty-datatype ;
    uo:quote "The structural format of the biomedical concept property response value." ;
    uo:rationale "The value names a datatype for the response value. The published examples use a small set of datatype names, and USDM_CT.xlsx gives no value list. See finding bc-property-datatype-names." ;
    dcterms:source ct:USDM_CT.xlsx ;
    dcterms:source <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> .
usdm:BiomedicalConceptProperty-datatype uo:contentKind uo:ClassificationAsText .

# ---------------------------------------------------------------- business identifiers, document positions, display labels

uoa:EligibilityCriterion-identifier a uo:Assessment ;
    uo:about usdm:EligibilityCriterion-identifier ;
    uo:assignedKind uo:BusinessIdentifier ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:EligibilityCriterion-identifier ;
    uo:quote "A sequence of characters used to identify, name, or characterize the inclusion or exclusion criterion." ;
    uo:rationale "Handle for a criterion within its study design, displayed in the protocol. In the published examples it restarts per category; see finding eligibility-identifier-needs-category." ;
    dcterms:source ct:USDM_CT.xlsx ;
    dcterms:source <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> .
usdm:EligibilityCriterion-identifier uo:contentKind uo:BusinessIdentifier .

uoa:Organization-identifier a uo:Assessment ;
    uo:about usdm:Organization-identifier ;
    uo:assignedKind uo:BusinessIdentifier ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:Organization-identifier ;
    uo:quote "A unique symbol that establishes identity of the organization." ;
    uo:rationale "Identifier issued by the organization named in identifierScheme. Displayed and compared, not parsed." ;
    dcterms:source ct:USDM_CT.xlsx .
usdm:Organization-identifier uo:contentKind uo:BusinessIdentifier .

uoa:StudyAmendment-number a uo:Assessment ;
    uo:about usdm:StudyAmendment-number ;
    uo:assignedKind uo:BusinessIdentifier ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:StudyAmendment-number ;
    uo:quote "A string of numerals that uniquely identifies a protocol amendment." ;
    uo:rationale "Handle that orders amendments. Displayed and compared, not used in arithmetic. See finding study-amendment-number-not-numerals." ;
    dcterms:source ct:USDM_CT.xlsx ;
    dcterms:source <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> .
usdm:StudyAmendment-number uo:contentKind uo:BusinessIdentifier .

uoa:StudyVersion-versionIdentifier a uo:Assessment ;
    uo:about usdm:StudyVersion-versionIdentifier ;
    uo:assignedKind uo:BusinessIdentifier ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:StudyVersion-versionIdentifier ;
    uo:quote "A sequence of characters used to identify, name, or characterize the study version." ;
    uo:rationale "Handle for a study version. Displayed and compared, not parsed." ;
    dcterms:source ct:USDM_CT.xlsx .
usdm:StudyVersion-versionIdentifier uo:contentKind uo:BusinessIdentifier .

uoa:StudyDefinitionDocumentVersion-version a uo:Assessment ;
    uo:about usdm:StudyDefinitionDocumentVersion-version ;
    uo:assignedKind uo:BusinessIdentifier ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:StudyDefinitionDocumentVersion-version ;
    uo:quote "A sequence of characters used to identify the version of the study definition document." ;
    uo:rationale "Handle for a document version. Displayed and compared, not parsed." ;
    dcterms:source ct:USDM_CT.xlsx .
usdm:StudyDefinitionDocumentVersion-version uo:contentKind uo:BusinessIdentifier .

uoa:MedicalDevice-hardwareVersion a uo:Assessment ;
    uo:about usdm:MedicalDevice-hardwareVersion ;
    uo:assignedKind uo:BusinessIdentifier ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:MedicalDevice-hardwareVersion ;
    uo:quote "A form or variant of hardware" ;
    uo:rationale "Version of the device hardware as assigned by its maker. Displayed and compared, not parsed." ;
    dcterms:source ct:USDM_CT.xlsx .
usdm:MedicalDevice-hardwareVersion uo:contentKind uo:BusinessIdentifier .

uoa:MedicalDevice-softwareVersion a uo:Assessment ;
    uo:about usdm:MedicalDevice-softwareVersion ;
    uo:assignedKind uo:BusinessIdentifier ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:MedicalDevice-softwareVersion ;
    uo:quote "A form or variant of software" ;
    uo:rationale "Version of the device software as assigned by its maker. Displayed and compared, not parsed." ;
    dcterms:source ct:USDM_CT.xlsx .
usdm:MedicalDevice-softwareVersion uo:contentKind uo:BusinessIdentifier .

uoa:ParameterMap-tag a uo:Assessment ;
    uo:about usdm:ParameterMap-tag ;
    uo:assignedKind uo:BusinessIdentifier ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:ParameterMap-tag ;
    uo:quote "Character strings bounded by angle brackets that act as containers for programming language elements." ;
    uo:rationale "Name of a parameter placeholder, matched by name against usdm:tag elements in syntax-template text. See finding template-tags-by-markup." ;
    dcterms:source ct:USDM_CT.xlsx ;
    dcterms:source <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> .
usdm:ParameterMap-tag uo:contentKind uo:BusinessIdentifier .

uoa:StudyDefinitionDocument-templateName a uo:Assessment ;
    uo:about usdm:StudyDefinitionDocument-templateName ;
    uo:assignedKind uo:BusinessIdentifier ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:StudyDefinitionDocument-templateName ;
    uo:quote "The literal identifier (i.e., distinctive designation) of the study definition document template." ;
    uo:rationale "The definition calls the value an identifier of the template, and that is followed here. The published values could also be read as a classification of templates." ;
    dcterms:source ct:USDM_CT.xlsx ;
    dcterms:source <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> .
usdm:StudyDefinitionDocument-templateName uo:contentKind uo:BusinessIdentifier .

uoa:NarrativeContent-sectionNumber a uo:Assessment ;
    uo:about usdm:NarrativeContent-sectionNumber ;
    uo:assignedKind uo:DocumentPosition ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:NarrativeContent-sectionNumber ;
    uo:quote "The numeric identifier assigned to a particular document section containing narrative content." ;
    uo:rationale "Position of the section in the document numbering. It changes when the document is restructured." ;
    dcterms:source ct:USDM_CT.xlsx .
usdm:NarrativeContent-sectionNumber uo:contentKind uo:DocumentPosition .

uoa:NarrativeContent-sectionTitle a uo:Assessment ;
    uo:about usdm:NarrativeContent-sectionTitle ;
    uo:assignedKind uo:DocumentPosition ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:NarrativeContent-sectionTitle ;
    uo:quote "An identifying designation for the document section containing narrative content." ;
    uo:rationale "Heading of the section as displayed in the document." ;
    dcterms:source ct:USDM_CT.xlsx .
usdm:NarrativeContent-sectionTitle uo:contentKind uo:DocumentPosition .

uoa:DocumentContentReference-sectionNumber a uo:Assessment ;
    uo:about usdm:DocumentContentReference-sectionNumber ;
    uo:assignedKind uo:DocumentPosition ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:DocumentContentReference-sectionNumber ;
    uo:quote "The numeric identifier of a particular section for the document content reference." ;
    uo:rationale "Points at a document section by its number. See finding document-content-reference-amendments-only." ;
    dcterms:source ct:USDM_CT.xlsx .
usdm:DocumentContentReference-sectionNumber uo:contentKind uo:DocumentPosition .

uoa:DocumentContentReference-sectionTitle a uo:Assessment ;
    uo:about usdm:DocumentContentReference-sectionTitle ;
    uo:assignedKind uo:DocumentPosition ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:DocumentContentReference-sectionTitle ;
    uo:quote "An identifying designation for a particular section for the document content reference." ;
    uo:rationale "Points at a document section by its heading, alongside the section number." ;
    dcterms:source ct:USDM_CT.xlsx .
usdm:DocumentContentReference-sectionTitle uo:contentKind uo:DocumentPosition .

uoa:Timing-valueLabel a uo:Assessment ;
    uo:about usdm:Timing-valueLabel ;
    uo:assignedKind uo:DisplayLabel ;
    uo:labelOf usdm:Timing-value ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:Timing-valueLabel ;
    uo:quote "The short descriptive designation for the timing value." ;
    uo:rationale "Free-text rendering of the encoded value. See finding timing-labels-restate-values." ;
    dcterms:source ct:USDM_CT.xlsx ;
    dcterms:source <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> .
usdm:Timing-valueLabel uo:contentKind uo:DisplayLabel .

uoa:Timing-windowLabel a uo:Assessment ;
    uo:about usdm:Timing-windowLabel ;
    uo:assignedKind uo:DisplayLabel ;
    uo:labelOf usdm:Timing-windowLower ;
    uo:labelOf usdm:Timing-windowUpper ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:Timing-windowLabel ;
    uo:quote "The short descriptive designation for a time period, or other type of interval, during which a temporal event may be achieved, obtained, or observed." ;
    uo:rationale "Free-text rendering of the window bounds, in a range notation of its own (lower..upper unit) that the model does not define." ;
    dcterms:source ct:USDM_CT.xlsx ;
    dcterms:source <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> .
usdm:Timing-windowLabel uo:contentKind uo:DisplayLabel .

uoa:Organization-identifierScheme a uo:Assessment ;
    uo:about usdm:Organization-identifierScheme ;
    uo:assignedKind uo:ClassificationAsText ;
    uo:evidenceTier uo:Authored ;
    uo:refines uod:Organization-identifierScheme ;
    uo:quote "The name of the organization that provides the identifier for the entity." ;
    uo:rationale "Names the organization that issues the identifier. The published examples use a small set of issuer names, and USDM_CT.xlsx gives no value list." ;
    dcterms:source ct:USDM_CT.xlsx ;
    dcterms:source <https://github.com/cdisc-org/DDF-RA/tree/v4.0.0/Documents/Examples> .
usdm:Organization-identifierScheme uo:contentKind uo:ClassificationAsText .
